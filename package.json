{
  "name": "port-royale-2-web",
  "version": "0.1.0",
  "private": true,
  "description": "Port Royale 2 in the browser: AssemblyScript/WASM simulation core + Three.js WebGL renderer.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "extract": "node scripts/extract/extract.ts",
    "build:wasm": "asc wasm/assembly/index.ts --config wasm/asconfig.json --target release",
    "build:wasm:debug": "asc wasm/assembly/index.ts --config wasm/asconfig.json --target debug",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "assemblyscript": "^0.28.9",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
